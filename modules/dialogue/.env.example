# silvercare-dialogue 환경변수 예시
# 사용하려면 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 Git에 올리지 않습니다)
# .env가 없어도 대화 알고리즘과 콘솔/파일 알림은 그대로 실행됩니다.

# [선택] 텔레그램 보호자 알림
# 두 값이 모두 있을 때만 기본 알림 채널에 텔레그램이 추가됩니다. (실제 계정 발송은 아직 검증 전)
# 주석은 값 뒤에 붙이지 말고 별도 줄에 쓰세요.

# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=
# 알림을 받을 채팅 ID
TELEGRAM_CHAT_ID=

# [선택] 보호자 웹/앱 연동 웹훅
# 값이 있으면 알림이 발생할 때 이 주소로 알림 JSON을 HTTP POST합니다. (타임아웃 3초)
# 로컬 테스트: python samples/webhook_receiver.py 실행 후 http://127.0.0.1:8765/alerts
ALERT_WEBHOOK_URL=
