# DAON 대화 모듈 환경변수 예시
# 이 파일을 .env로 복사한 뒤 실제 API 키를 입력하세요.
# .env에는 민감한 정보가 포함되므로 GitHub에 올리지 않습니다.
# .env.example에는 실제 API 키를 입력하지 마세요.


# ============================================================
# 1. LLM 일반 대화 설정
# ============================================================

# LLM 제공자
DIALOGUE_LLM=openai

# 사용할 모델
DIALOGUE_LLM_MODEL=gpt-4.1-mini

# OpenAI API 키 (교수님 제공 key 사용, .env 파일에만 실제 키 입력)
OPENAI_API_KEY=

# LLM 응답 대기 제한 시간 (초)
DIALOGUE_LLM_TIMEOUT=2.5


# ============================================================
# 2. 보호자 웹/앱 연동 웹훅 [선택]
# ============================================================

# 알림 발생 시 지정한 주소로 JSON을 HTTP POST합니다.
# 사용하지 않으면 비워두세요.
# 로컬 테스트: python samples/webhook_receiver.py
ALERT_WEBHOOK_URL=
